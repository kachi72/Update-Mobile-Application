<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="@drawable/screen_gradient_network"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".offlineMode.OfflineNetworkActivity">

    <TextView
        android:id="@+id/header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:text="What's new in the world of Networking"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:layout_margin="10dp"
        android:textSize="15dp"
        />

    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/recycler"
        android:layout_margin="10dp"
        android:layout_below="@id/header"/>

    <include
        android:id="@+id/child"
        layout="@layout/offline_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="gone"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/txtNoArticle"
        android:layout_centerInParent="true"
        android:text="@string/offline_no_article"
        android:textColor="@color/white"
        android:textStyle="bold|italic"
        android:textSize="20sp"
        android:visibility="gone"/>

</RelativeLayout>
